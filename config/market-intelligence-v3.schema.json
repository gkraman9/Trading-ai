        "symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "observation_at_utc": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "enum": [
            null,
            "SYNTHETIC_RESEARCH",
            "HISTORICAL_RESEARCH",
            "VALIDATED_LIVE"
          ]
