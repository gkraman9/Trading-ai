    "status": {
      "enum": [
        "BLOCKED",
        "UNKNOWN",
        "ABSTAINED",
        "ASSESSED"
      ]
    },
    "market_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "observation_at_utc",
        "provenance",
        "available_timeframes",
        "closed_through",
        "regime",
        "directional_bias",
        "trend_structure",
