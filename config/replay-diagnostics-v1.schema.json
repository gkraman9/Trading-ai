                          "minimum": 0
                        },
                        "warmup_uncovered_m5_bars": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "start_utc": {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "(Z|\\+00:00)$"
                        },
                        "end_utc": {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "(Z|\\+00:00)$"
                        },
                        "denominator_basis": {
                          "enum": [
                            "UTC_GRID_SESSION_COVERAGE_UNVERIFIED",
                            "VERIFIED_CALENDAR_FULL_M5_INTERVALS"
