                        "consistency_evidence": {
                          "enum": [
                            "INTERNAL_AGGREGATION_ONLY",
                            "SAME_FEED_NATIVE_COMPARISON",
                            "LINEAGE_UNVERIFIED"
                          ]
                        },
                        "cross_frame_claim": {
                          "enum": [
                            "NOT_ESTABLISHED",
                            "SCOPED_SAME_FEED_CONSISTENCY"
                          ]
                        },
                        "provided_coverage_percent": {
