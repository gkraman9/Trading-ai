    "historical_comparisons",
    "sha256"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iat:replay-diagnostics:v1",
  "$defs": {
    "metric": {
      "type": "object",
      "properties": {
        "numerator": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "denominator": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "denominator_basis": {
          "type": "string",
          "pattern": "^[A-Z0-9_]{1,100}$"
        },
        "percent": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "MEASURED",
            "NO_OBSERVATIONS",
            "NOT_ESTABLISHED"
          ]
        }
      },
      "required": [
        "numerator",
        "denominator",
        "denominator_basis",
        "percent",
        "status"
      ],
      "additionalProperties": false
    },
    "attribution": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "pattern": "^[A-Z0-9_]{1,100}$"
        },
        "upstream_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]{1,100}$"
          }
        },
        "explanation": {
          "type": "string"
        },
        "research_action": {
          "type": "string"
        }
      },
      "required": [
        "category",
        "upstream_codes",
        "explanation",
        "research_action"
      ],
      "additionalProperties": false
    },
    "frequency": {
      "type": "object",
      "properties": {
        "denominator": {
          "type": "integer",
          "minimum": 0
        },
        "denominator_basis": {
          "type": "string",
          "pattern": "^[A-Z0-9_]{1,100}$"
        },
        "codes": {
          "type": "object",
          "patternProperties": {
            "^[A-Z0-9_]{1,100}$": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "denominator",
        "denominator_basis",
        "codes"
      ],
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "classification": {
          "type": "string",
          "pattern": "^[A-Z0-9_]{1,100}$"
        },
        "phase7_alignment": {
          "type": "string",
          "pattern": "^[A-Z0-9_]{1,100}$"
        },
        "m1_structure": {
          "enum": [
            "BULLISH",
            "BEARISH",
            "RANGING",
            "TRANSITIONAL",
            "UNKNOWN"
          ]
        },
        "m5_structure": {
          "enum": [
            "BULLISH",
            "BEARISH",
            "RANGING",
            "TRANSITIONAL",
            "UNKNOWN"
          ]
        },
        "m1_as_of": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|\\+00:00)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "m5_as_of": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|\\+00:00)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]{1,100}$"
          }
        }
      },
      "required": [
        "classification",
        "phase7_alignment",
        "m1_structure",
        "m5_structure",
        "m1_as_of",
        "m5_as_of",
        "limitations"
      ],
      "additionalProperties": false
    },
    "boundary": {
      "type": "object",
      "properties": {
        "closed_count": {
          "type": "integer",
          "minimum": 0
        },
        "prefix_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "first_open_utc": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|\\+00:00)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_open_utc": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|\\+00:00)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_close_utc": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|\\+00:00)$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "closed_count",
        "prefix_sha256",
        "first_open_utc",
        "last_open_utc",
        "last_close_utc"
      ],
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "properties": {
        "diagnostic_observation_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_record_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_record_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "timestamp_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "phase": {
          "enum": [
            "WARMUP",
            "EVALUATION"
          ]
        },
        "snapshot_status": {
          "enum": [
            "ASSESSED",
            "ABSTAINED",
            "BLOCKED"
          ]
        },
        "transition_classification": {
          "enum": [
            "ABSTAINED",
            "BLOCKED",
            "INVALIDATED",
            "NEW",
            "PERSISTING",
            "REPLACED",
            "STRENGTHENING",
            "WEAKENING"
          ]
        },
        "upstream_reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]{1,100}$"
          }
        },
        "snapshot_reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]{1,100}$"
          }
        },
        "transition_reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]{1,100}$"
          }
        },
        "snapshot_attribution": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attribution"
          }
        },
        "transition_attribution": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attribution"
          }
        },
        "stage_references_available": {
          "type": "object",
          "properties": {
            "market_intelligence": {
              "type": "boolean"
            },
            "market_context": {
              "type": "boolean"
            },
            "scenario_assessment": {
              "type": "boolean"
            },
            "scenario_transition": {
              "type": "boolean"
            }
          },
          "required": [
            "market_intelligence",
            "market_context",
            "scenario_assessment",
            "scenario_transition"
          ],
          "additionalProperties": false
        },
        "stage_reference_integrity_valid": {
          "type": "object",
          "properties": {
            "market_intelligence": {
              "type": "boolean"
            },
            "market_context": {
              "type": "boolean"
            },
            "scenario_assessment": {
              "type": "boolean"
            },
            "scenario_transition": {
              "type": "boolean"
            }
          },
          "required": [
            "market_intelligence",
            "market_context",
            "scenario_assessment",
            "scenario_transition"
          ],
          "additionalProperties": false
        },
        "complete_required_chain": {
          "type": "boolean"
        },
        "missing_required_references": {
          "type": "array",
          "items": {
            "enum": [
              "market_intelligence",
              "market_context",
              "scenario_assessment",
              "scenario_transition",
              "assessment_normalized_context",
              "decision"
            ]
          }
        },
        "sufficiency": {
          "enum": [
            "UPSTREAM_RESEARCH_ELIGIBLE",
            "QUALITY_BLOCKED",
            "NOT_ESTABLISHED"
          ]
        },
        "evidence": {
          "type": "object",
          "properties": {
            "available_count": {
              "type": "integer",
              "minimum": 0
            },
            "available_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^M[15]:[A-Z_]+:[a-f0-9]{64}$"
              }
            },
            "by_category": {
              "type": "object",
              "properties": {
                "CANDLE": {
                  "type": "integer",
                  "minimum": 0
                },
                "LIQUIDITY": {
                  "type": "integer",
                  "minimum": 0
                },
                "MOMENTUM": {
                  "type": "integer",
                  "minimum": 0
                },
                "STRUCTURE": {
                  "type": "integer",
                  "minimum": 0
                },
                "SUPPLY_DEMAND": {
                  "type": "integer",
                  "minimum": 0
                },
                "SUPPORT_RESISTANCE": {
                  "type": "integer",
                  "minimum": 0
                },
                "TRANSITION": {
                  "type": "integer",
                  "minimum": 0
                },
                "VOLATILITY": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "CANDLE",
                "LIQUIDITY",
                "MOMENTUM",
                "STRUCTURE",
                "SUPPLY_DEMAND",
                "SUPPORT_RESISTANCE",
                "TRANSITION",
                "VOLATILITY"
              ],
              "additionalProperties": false
            },
            "by_timeframe": {
              "type": "object",
              "properties": {
                "M1": {
                  "type": "integer",
                  "minimum": 0
                },
                "M5": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "M1",
                "M5"
              ],
              "additionalProperties": false
            },
            "confirmed_structure": {
              "type": "object",
              "properties": {
                "M1": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": [
                        "CONFIRMED_CONTEXT",
                        "INSUFFICIENT",
                        "UNAVAILABLE"
                      ]
                    },
                    "evidence_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^M[15]:[A-Z_]+:[a-f0-9]{64}$"
                      }
                    }
                  },
                  "required": [
                    "status",
                    "evidence_ids"
                  ],
                  "additionalProperties": false
                },
                "M5": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": [
                        "CONFIRMED_CONTEXT",
                        "INSUFFICIENT",
                        "UNAVAILABLE"
                      ]
                    },
                    "evidence_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^M[15]:[A-Z_]+:[a-f0-9]{64}$"
                      }
                    }
                  },
                  "required": [
                    "status",
                    "evidence_ids"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "M1",
                "M5"
              ],
              "additionalProperties": false
            },
            "context_frames_unavailable": {
              "type": "array",
              "items": {
                "enum": [
                  "M1",
                  "M5"
                ]
              }
            }
          },
          "required": [
            "available_count",
            "available_ids",
            "by_category",
            "by_timeframe",
            "confirmed_structure",
            "context_frames_unavailable"
          ],
          "additionalProperties": false
        },
        "available_candles": {
          "type": "object",
          "properties": {
            "M1": {
              "$ref": "#/$defs/boundary"
            },
            "M5": {
              "$ref": "#/$defs/boundary"
            }
          },
          "required": [
            "M1",
            "M5"
          ],
          "additionalProperties": false
        },
        "timeframe_context": {
          "$ref": "#/$defs/context"
        },
        "causal_frame_alignment_confirmed": {
          "type": "boolean"
        },
        "temporal": {
          "type": "object",
          "properties": {
            "previous_record_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "elapsed_seconds": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "adjacent_m1_observation": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "snapshot_status_changed": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "transition_classification_changed": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "snapshot_run_length": {
              "type": "integer",
              "minimum": 1
            },
            "transition_run_length": {
              "type": "integer",
              "minimum": 1
            },
            "evidence_added": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^M[15]:[A-Z_]+:[a-f0-9]{64}$"
              }
            },
            "evidence_removed": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^M[15]:[A-Z_]+:[a-f0-9]{64}$"
              }
            },
            "frame_close_changed": {
              "type": "object",
              "properties": {
                "M1": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "M5": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "M1",
                "M5"
              ],
              "additionalProperties": false
            },
            "warmup_to_evaluation": {
              "type": "boolean"
            },
            "entered_upstream_eligibility": {
              "type": "boolean"
            },
            "warmup_to_eligible": {
              "type": "boolean"
            }
          },
          "required": [
            "previous_record_id",
            "elapsed_seconds",
            "adjacent_m1_observation",
            "snapshot_status_changed",
            "transition_classification_changed",
            "snapshot_run_length",
            "transition_run_length",
            "evidence_added",
            "evidence_removed",
            "frame_close_changed",
            "warmup_to_evaluation",
            "entered_upstream_eligibility",
            "warmup_to_eligible"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "diagnostic_observation_id",
        "source_record_id",
        "source_record_sha256",
        "timestamp_utc",
        "phase",
        "snapshot_status",
        "transition_classification",
        "upstream_reason_codes",
        "snapshot_reason_codes",
        "transition_reason_codes",
        "snapshot_attribution",
        "transition_attribution",
        "stage_references_available",
        "stage_reference_integrity_valid",
        "complete_required_chain",
        "missing_required_references",
        "sufficiency",
        "evidence",
        "available_candles",
        "timeframe_context",
        "causal_frame_alignment_confirmed",
        "temporal"
      ],
      "additionalProperties": false
    }
  },
  "description": "Structural schema only. validate_replay_diagnostics(report, source_replay) is required for checksum binding and full semantic validation."
}
