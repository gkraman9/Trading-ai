                        "comparable_m5_bars",
                        "uncovered_m5_bars",
                        "missing_m5_bars",
                        "unexpected_m5_bars",
                        "mismatch_count",
                        "minimum_comparable_m5_bars",
                        "warmup_m5_bars",
                        "warmup_uncovered_m5_bars",
                        "start_utc",
                        "end_utc",
                        "denominator_basis",
                        "coverage_sufficient",
                        "m5_origin",
                        "consistency_evidence",
                        "cross_frame_claim",
                        "provided_coverage_percent",
                        "comparable_coverage_percent",
                        "matching_coverage_percent"
                      ],
                      "additionalProperties": false
