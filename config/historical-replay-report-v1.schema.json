                "type": "string"
              }
            }
          },
          "required": [
            "frames",
            "alignment",
            "requirements"
          ],
          "additionalProperties": false
        }
      ]
    },
    "decision_log": {
      "anyOf": [
        {
          "$ref": "#/$defs/DecisionLog"
        },
        {
          "type": "null"
        }
      ]
    },
    "decision_log_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "oneOf": [
        {
          "type": "object",
          "maxProperties": 0
        },
        {
          "type": "object",
          "properties": {
            "snapshots": {
              "type": "integer",
              "minimum": 0
            },
            "valid_snapshots": {
              "type": "integer",
              "minimum": 0
            },
            "blocked_snapshots": {
              "type": "integer",
              "minimum": 0
            },
            "abstentions": {
              "type": "integer",
              "minimum": 0
            },
            "hypothesis_changes": {
              "type": "integer",
              "minimum": 0
            },
            "evidence_appearances": {
              "type": "integer",
              "minimum": 0
            },
            "unique_contextual_evidence_versions": {
              "type": "integer",
              "minimum": 0
            },
            "unique_choch_events": {
              "type": "integer",
              "minimum": 0
            },
            "choch_context_revisions": {
              "type": "integer",
              "minimum": 0
            },
            "abstention_reason_counts": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            },
            "blocked_reason_counts": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            },
            "selected_hypothesis_counts": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            },
            "decision_start_utc": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "(Z|\\+00:00)$"
                },
