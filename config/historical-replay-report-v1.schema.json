                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "snapshots",
            "valid_snapshots",
            "blocked_snapshots",
            "abstentions",
            "hypothesis_changes",
            "evidence_appearances",
            "unique_contextual_evidence_versions",
            "unique_choch_events",
            "choch_context_revisions",
            "abstention_reason_counts",
            "blocked_reason_counts",
            "selected_hypothesis_counts",
            "decision_start_utc",
            "decision_end_utc"
          ],
          "additionalProperties": false
