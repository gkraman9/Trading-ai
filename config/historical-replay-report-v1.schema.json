{
  "type": "object",
  "properties": {
    "report_version": {
      "const": 1
    },
    "kind": {
      "const": "HISTORICAL_PIPELINE_REPLAY"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "BLOCKED"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "historical_validation": {
      "enum": [
        "PENDING",
        "FAILED",
        "DATASET_PIPELINE_CHECKS_PASSED"
      ]
    },
    "dataset": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "manifest_version": {
              "const": 1
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "symbol": {
              "const": "XAUUSD"
            },
            "dataset_kind": {
              "enum": [
                "SYNTHETIC_FIXTURE",
                "INDEPENDENT_HISTORICAL"
              ]
            },
            "source": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9 ._()/:-]{1,100}$"
                },
                "reference": {
                  "type": "string",
                  "maxLength": 512
                },
                "retrieved_at_utc": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "(Z|\\+00:00)$"
                },
                "curation_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                },
                "independent_review": {
                  "enum": [
                    "PENDING",
                    "ATTESTED"
                  ]
                }
              },
              "required": [
                "name",
                "reference",
                "retrieved_at_utc",
                "curation_id",
                "independent_review"
              ],
              "additionalProperties": false
            },
            "utc_range": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "(Z|\\+00:00)$"
                },
                "end": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "(Z|\\+00:00)$"
                }
              },
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false
            },
            "coverage": {
              "type": "object",
              "properties": {
                "M1": {
                  "type": "object",
                  "properties": {
                    "candle_count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "start_utc": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "(Z|\\+00:00)$"
                    },
                    "end_utc": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "(Z|\\+00:00)$"
                    }
                  },
                  "required": [
                    "candle_count",
                    "start_utc",
                    "end_utc"
                  ],
                  "additionalProperties": false
                },
                "M5": {
                  "type": "object",
                  "properties": {
                    "candle_count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "start_utc": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "(Z|\\+00:00)$"
                    },
                    "end_utc": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "(Z|\\+00:00)$"
                    }
                  },
                  "required": [
                    "candle_count",
                    "start_utc",
                    "end_utc"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "M1",
                "M5"
              ],
              "additionalProperties": false
            },
            "checksums": {
              "type": "object",
              "properties": {
                "M1": {
                  "type": "object",
                  "properties": {
                    "file_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "normalized_ohlc_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "file_sha256",
                    "normalized_ohlc_sha256"
                  ],
                  "additionalProperties": false
                },
                "M5": {
                  "type": "object",
                  "properties": {
                    "file_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "normalized_ohlc_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "file_sha256",
                    "normalized_ohlc_sha256"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "M1",
                "M5"
              ],
              "additionalProperties": false
            },
            "session_config_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "finality_attested": {
              "type": "boolean"
            },
            "source_authenticity": {
              "const": "OPERATOR_DECLARATION_NOT_AUTHENTICATED"
            }
          },
          "required": [
            "manifest_version",
            "manifest_sha256",
            "symbol",
            "dataset_kind",
            "source",
            "utc_range",
            "coverage",
            "checksums",
            "session_config_sha256",
            "finality_attested",
            "source_authenticity"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "configurations": {
      "oneOf": [
        {
          "type": "object",
          "maxProperties": 0
        },
        {
          "type": "object",
          "properties": {
            "hashes": {
              "type": "object",
              "properties": {
                "context": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "intelligence": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "session": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "replay_policy": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "context",
                "intelligence",
                "session",
                "replay_policy"
              ],
              "additionalProperties": false
            },
            "context": {
              "type": "object",
