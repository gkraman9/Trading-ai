                  "maximum": 1
                },
                "base_width_ratio": {
                  "type": "number",
                  "minimum": 1
                },
                "departure_range_multiple": {
                  "type": "number",
                  "minimum": 1
                },
                "departure_atr_multiple": {
                  "type": "number",
                  "minimum": 0
                },
                "departure_body_ratio": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 1
                },
                "roc_period": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 100
                },
                "atr_period": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 100
                },
                "range_period": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 100
                },
                "momentum_threshold": {
                  "type": "number",
                  "minimum": 0
                },
                "acceleration_threshold": {
                  "type": "number",
                  "minimum": 0
                },
                "volatility_high": {
                  "type": "number",
                  "exclusiveMinimum": 1
                },
                "volatility_low": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 1
                },
                "breakout_closes": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 100
                },
                "minimum_score": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "contradiction_limit": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "minimum_margin": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "structure_weight": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "zone_weight": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "liquidity_weight": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "momentum_weight": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "candle_weight": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "version",
                "cluster_tolerance",
                "zone_half_width",
                "minimum_touches",
                "break_tolerance",
                "base_bars",
                "base_range_ratio",
                "base_width_ratio",
                "departure_range_multiple",
                "departure_atr_multiple",
                "departure_body_ratio",
                "roc_period",
                "atr_period",
                "range_period",
                "momentum_threshold",
                "acceleration_threshold",
                "volatility_high",
                "volatility_low",
                "breakout_closes",
                "minimum_score",
                "contradiction_limit",
                "minimum_margin",
                "structure_weight",
                "zone_weight",
                "liquidity_weight",
                "momentum_weight",
                "candle_weight"
              ],
              "additionalProperties": false
            },
            "intelligence": {
              "type": "object",
              "properties": {
                "version": {
                  "const": 1
                },
                "epsilon": {
                  "type": "number",
                  "minimum": 0
                },
                "doji_ratio": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 1
                },
                "small_body_ratio": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 1
                },
                "long_wick_body": {
                  "type": "number",
                  "minimum": 1
                },
                "short_wick_range": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 1
                },
                "momentum_body_ratio": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 1
                },
                "momentum_relative_range": {
                  "type": "number",
                  "minimum": 1
                },
                "range_window": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "trend_window": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 100
                },
                "star_recovery": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 1
                },
                "left_strength": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "right_strength": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "equal_tolerance": {
                  "type": "number",
                  "minimum": 0
                },
                "break_policy": {
                  "enum": [
                    "CLOSE",
                    "WICK"
                  ]
                },
                "min_break_distance": {
                  "type": "number",
                  "minimum": 0
                },
                "atr_period": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "atr_multiplier": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "version",
                "epsilon",
                "doji_ratio",
                "small_body_ratio",
                "long_wick_body",
                "short_wick_range",
                "momentum_body_ratio",
                "momentum_relative_range",
                "range_window",
                "trend_window",
                "star_recovery",
                "left_strength",
                "right_strength",
                "equal_tolerance",
                "break_policy",
                "min_break_distance",
                "atr_period",
                "atr_multiplier"
              ],
              "additionalProperties": false
            },
            "window": {
              "type": "integer",
              "minimum": 3,
              "maximum": 5000
            }
          },
          "required": [
            "hashes",
            "context",
            "intelligence",
            "window"
          ],
          "additionalProperties": false
        }
      ]
    },
    "preflight": {
      "oneOf": [
        {
          "type": "object",
          "maxProperties": 0
        },
        {
          "type": "object",
          "properties": {
            "frames": {
              "type": "object",
              "properties": {
                "M1": {
                  "type": "object",
                  "properties": {
                    "valid": {
                      "type": "boolean"
                    },
                    "diagnostics": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string"
                          },
                          "severity": {
                            "enum": [
                              "INFO",
                              "WARNING",
                              "ERROR"
                            ]
                          },
                          "message": {
                            "type": "string"
                          },
                          "timeframe": {
                            "enum": [
                              "M1",
                              "M5"
                            ]
                          }
                        },
                        "required": [
                          "code",
                          "severity",
                          "message"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "valid",
                    "diagnostics"
                  ],
                  "additionalProperties": false
                },
                "M5": {
                  "type": "object",
                  "properties": {
                    "valid": {
                      "type": "boolean"
                    },
                    "diagnostics": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string"
                          },
                          "severity": {
                            "enum": [
                              "INFO",
                              "WARNING",
                              "ERROR"
                            ]
                          },
                          "message": {
                            "type": "string"
                          },
                          "timeframe": {
                            "enum": [
                              "M1",
                              "M5"
                            ]
                          }
                        },
                        "required": [
                          "code",
                          "severity",
                          "message"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "valid",
                    "diagnostics"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "M1",
                "M5"
              ],
              "additionalProperties": false
            },
            "alignment": {
              "oneOf": [
                {
                  "type": "object",
                  "maxProperties": 0
                },
                {
                  "type": "object",
                  "properties": {
                    "policy": {
                      "const": "FIVE_M1_TO_M5_OHLC_ABSOLUTE_TOLERANCE"
                    },
                    "tolerance": {
                      "type": "number",
                      "minimum": 0
                    },
                    "comparable_m5_bars": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "uncovered_m5_bars": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "mismatch_count": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "policy",
                    "tolerance",
                    "comparable_m5_bars",
                    "uncovered_m5_bars",
                    "mismatch_count"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "requirements": {
              "type": "array",
