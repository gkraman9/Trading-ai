            },
            "candle_count": {
              "type": "integer",
              "minimum": 0
            },
            "measurements": {
              "$ref": "#/$defs/Measurements"
            },
            "momentum": {
              "$ref": "#/$defs/Momentum"
            },
            "volatility": {
              "$ref": "#/$defs/Volatility"
            }
          },
          "required": [
            "data_as_of",
            "candle_count",
            "measurements",
            "momentum",
            "volatility"
          ],
          "additionalProperties": false
        },
        "M5": {
          "type": "object",
          "properties": {
            "data_as_of": {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|\\+00:00)$"
            },
            "candle_count": {
              "type": "integer",
              "minimum": 0
            },
            "measurements": {
              "$ref": "#/$defs/Measurements"
            },
            "momentum": {
              "$ref": "#/$defs/Momentum"
            },
            "volatility": {
              "$ref": "#/$defs/Volatility"
            }
          },
          "required": [
            "data_as_of",
            "candle_count",
            "measurements",
            "momentum",
            "volatility"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "interpretations": {
