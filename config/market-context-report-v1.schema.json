{
  "type": "object",
  "properties": {
    "report_version": {
      "const": 1
    },
    "model_version": {
      "const": "IAT_MARKET_CONTEXT_V1"
    },
    "configuration_version": {
      "const": 1
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "intelligence_configuration_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "configuration": {
      "$ref": "#/$defs/Configuration"
    },
    "symbol": {
      "type": "string"
    },
    "analysis_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|\\+00:00)$"
    },
    "provenance": {
      "enum": [
        "SYNTHETIC_RESEARCH",
        "HISTORICAL_RESEARCH",
        "VALIDATED_LIVE",
        "UNVERIFIED"
      ]
    },
    "data_quality": {
