                    "$ref": "#/$defs/Zone"
                  }
                },
                "supply_demand": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Zone"
                  }
                },
                "liquidity_pools": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Pool"
                  }
                },
                "liquidity_events": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/LiquidityEvent"
                  }
                },
                "structure": {
                  "$ref": "#/$defs/Structure"
                },
                "patterns": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Pattern"
                  }
                },
                "momentum": {
                  "$ref": "#/$defs/Momentum"
                },
                "volatility": {
                  "$ref": "#/$defs/Volatility"
                }
              },
              "required": [
                "support_resistance",
                "supply_demand",
                "liquidity_pools",
                "liquidity_events",
                "structure",
                "patterns",
                "momentum",
                "volatility"
              ],
              "additionalProperties": false
            },
            "M5": {
              "type": "object",
              "properties": {
                "support_resistance": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Zone"
                  }
                },
                "supply_demand": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Zone"
                  }
                },
                "liquidity_pools": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Pool"
                  }
                },
                "liquidity_events": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/LiquidityEvent"
                  }
                },
                "structure": {
                  "$ref": "#/$defs/Structure"
                },
                "patterns": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Pattern"
                  }
                },
                "momentum": {
                  "$ref": "#/$defs/Momentum"
                },
                "volatility": {
                  "$ref": "#/$defs/Volatility"
                }
              },
              "required": [
                "support_resistance",
                "supply_demand",
                "liquidity_pools",
                "liquidity_events",
                "structure",
                "patterns",
                "momentum",
                "volatility"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "source_registry": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "timeframe": {
                "enum": [
                  "M1",
                  "M5"
                ]
              },
              "observed_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "(Z|\\+00:00)$"
              },
              "available_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "(Z|\\+00:00)$"
              },
              "ohlc": {
                "type": "object",
                "properties": {
                  "open": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "high": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "low": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "close": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "open",
                  "high",
                  "low",
                  "close"
                ],
                "additionalProperties": false
              },
              "price": {
                "type": "number",
                "minimum": 0
              },
              "pivot_kind": {
                "type": "string"
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "lower": {
                "type": "number",
                "minimum": 0
              },
              "upper": {
                "type": "number",
                "minimum": 0
              },
              "level": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "kind",
              "timeframe",
              "observed_at",
              "available_at"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Evidence"
      }
    },
    "context": {
      "$ref": "#/$defs/Context"
    },
    "confluence": {
      "type": "object",
      "properties": {
        "score_kind": {
          "const": "HEURISTIC_EVIDENCE_NOT_PROBABILITY"
        },
        "scores": {
          "type": "object",
          "properties": {
            "BULLISH": {
              "type": "number",
              "minimum": 0
            },
            "BEARISH": {
              "type": "number",
              "minimum": 0
            },
            "RANGING": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "leader": {
          "type": "string"
        },
        "opposition_score": {
          "type": "number",
          "minimum": 0
        },
        "margin": {
          "type": "number"
        },
        "weighted_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "evidence_id": {
                "type": "string"
              },
              "bucket": {
                "type": "string"
              },
              "timeframe": {
                "enum": [
                  "M1",
                  "M5"
                ]
              },
              "direction": {
                "type": "string"
              },
              "weight": {
                "type": "number",
                "minimum": 0
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "evidence_id",
              "bucket",
              "timeframe",
              "direction",
              "weight",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "fresh_opposing_m1_choch": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "abstention_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "selected_hypothesis": {
          "type": "string"
        }
      },
      "required": [
        "score_kind",
        "scores",
        "weighted_evidence",
        "abstention_reasons",
        "selected_hypothesis"
      ],
      "additionalProperties": false
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Hypothesis"
      }
    },
    "abstention_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "explanation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mode": {
      "const": "READ_ONLY_SHADOW"
    },
    "signal": {
      "const": "WAIT"
    },
    "execution_allowed": {
      "const": false
    }
  },
  "required": [
    "report_version",
    "model_version",
    "configuration_version",
    "configuration_sha256",
    "intelligence_configuration_sha256",
    "configuration",
    "symbol",
    "analysis_at",
    "provenance",
    "data_quality",
    "observed_facts",
    "interpretations",
    "evidence",
    "context",
    "confluence",
    "hypotheses",
    "abstention_reasons",
    "explanation",
    "mode",
    "signal",
    "execution_allowed"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IAT Market Context report v1 (pure engine)",
  "$defs": {
    "Configuration": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "cluster_tolerance": {
          "type": "number",
          "minimum": 0
        },
        "zone_half_width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimum_touches": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100
        },
        "break_tolerance": {
          "type": "number",
          "minimum": 0
        },
        "base_bars": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100
        },
        "base_range_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "base_width_ratio": {
          "type": "number",
          "minimum": 1
        },
        "departure_range_multiple": {
          "type": "number",
          "minimum": 1
        },
        "departure_atr_multiple": {
          "type": "number",
          "minimum": 0
        },
        "departure_body_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "roc_period": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100
        },
        "atr_period": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100
        },
        "range_period": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100
        },
        "momentum_threshold": {
          "type": "number",
          "minimum": 0
        },
        "acceleration_threshold": {
          "type": "number",
          "minimum": 0
        },
        "volatility_high": {
          "type": "number",
          "exclusiveMinimum": 1
        },
        "volatility_low": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "breakout_closes": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100
        },
        "minimum_score": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "contradiction_limit": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimum_margin": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "structure_weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "zone_weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "liquidity_weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "momentum_weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "candle_weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "version",
        "cluster_tolerance",
        "zone_half_width",
        "minimum_touches",
        "break_tolerance",
        "base_bars",
        "base_range_ratio",
        "base_width_ratio",
        "departure_range_multiple",
        "departure_atr_multiple",
        "departure_body_ratio",
        "roc_period",
        "atr_period",
        "range_period",
        "momentum_threshold",
        "acceleration_threshold",
        "volatility_high",
        "volatility_low",
        "breakout_closes",
        "minimum_score",
        "contradiction_limit",
        "minimum_margin",
        "structure_weight",
        "zone_weight",
        "liquidity_weight",
        "momentum_weight",
        "candle_weight"
      ],
      "additionalProperties": false
    },
    "Zone": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "SUPPORT",
            "RESISTANCE",
            "SUPPLY",
            "DEMAND"
          ]
        },
        "timeframe": {
          "enum": [
            "M1",
            "M5"
          ]
        },
        "origin_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "confirmed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "status": {
          "enum": [
            "FRESH",
            "TESTED",
            "BROKEN",
            "INVALIDATED",
            "ROLE_REVERSAL_CANDIDATE"
          ]
        },
        "prior_structure": {
          "type": "string"
        },
        "lower": {
          "type": "number",
          "minimum": 0
        },
        "upper": {
          "type": "number",
          "minimum": 0
        },
        "supporting_pivots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "historical_touches": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "date-time",
            "pattern": "(Z|\\+00:00)$"
          }
        },
        "retests": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "date-time",
            "pattern": "(Z|\\+00:00)$"
          }
        },
        "broken_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|\\+00:00)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "invalidated_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|\\+00:00)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "potential_role_reversal": {
          "type": "boolean"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "timeframe",
        "origin_at",
        "confirmed_at",
        "status",
        "prior_structure",
        "lower",
        "upper",
        "supporting_pivots",
        "evidence",
        "historical_touches",
        "retests",
        "broken_at",
        "invalidated_at",
        "potential_role_reversal",
        "reason_codes"
      ],
      "additionalProperties": false
    },
    "Pool": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "SWING_HIGHS",
            "SWING_LOWS",
            "EQUAL_HIGHS",
            "EQUAL_LOWS"
          ]
        },
        "timeframe": {
          "enum": [
            "M1",
            "M5"
          ]
        },
        "level": {
          "type": "number",
          "minimum": 0
        },
        "confirmed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "touches": {
          "type": "integer",
          "minimum": 0
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "timeframe",
        "level",
        "confirmed_at",
        "evidence",
        "touches",
        "reason_codes"
      ],
      "additionalProperties": false
    },
    "LiquidityEvent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "pool_id": {
          "type": "string"
        },
        "event_type": {
          "enum": [
            "LEVEL_PENETRATION",
            "CONFIRMED_SWEEP",
            "SUSTAINED_BREAKOUT",
            "AMBIGUOUS_EVENT"
          ]
        },
        "timeframe": {
          "enum": [
            "M1",
            "M5"
          ]
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "available_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "level": {
          "type": "number",
          "minimum": 0
        },
        "candle": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "pool_id",
        "event_type",
        "timeframe",
        "occurred_at",
        "available_at",
        "level",
        "candle",
        "evidence",
        "reason_codes"
      ],
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "category": {
          "enum": [
            "STRUCTURE",
            "TRANSITION",
            "SUPPORT_RESISTANCE",
            "SUPPLY_DEMAND",
            "LIQUIDITY",
            "MOMENTUM",
            "VOLATILITY",
            "CANDLE"
          ]
        },
        "timeframe": {
          "enum": [
            "M1",
            "M5"
          ]
        },
        "direction": {
          "enum": [
            "BULLISH",
            "BEARISH",
            "RANGING",
            "NEUTRAL"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "available_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "details": {
          "type": "object"
        },
        "event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "category",
        "timeframe",
        "direction",
        "observed_at",
        "available_at",
        "references",
        "reason_codes",
        "details"
      ],
      "additionalProperties": false
    },
    "Context": {
      "type": "object",
      "properties": {
        "classification": {
          "type": "string"
        },
        "phase7_alignment": {
          "type": "string"
        },
        "m1_structure": {
          "type": "string"
        },
        "m5_structure": {
          "type": "string"
        },
        "m1_as_of": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|\\+00:00)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "m5_as_of": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|\\+00:00)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "classification",
        "phase7_alignment",
        "m1_structure",
        "m5_structure",
        "m1_as_of",
        "m5_as_of",
        "limitations"
      ],
      "additionalProperties": false
    },
    "Hypothesis": {
      "type": "object",
      "properties": {
        "hypothesis_type": {
          "enum": [
            "BULLISH_CONTINUATION_POSSIBILITY",
            "BEARISH_CONTINUATION_POSSIBILITY",
            "BULLISH_STRUCTURAL_TRANSITION",
            "BEARISH_STRUCTURAL_TRANSITION",
            "RANGE_CONTINUATION",
            "NO_CLEAR_DIRECTIONAL_HYPOTHESIS"
          ]
        },
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "model_version": {
          "const": "IAT_MARKET_CONTEXT_V1"
        },
        "configuration_version": {
          "const": 1
        },
        "supporting_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contradictory_evidence": {
          "type": "array",
          "items": {
            "type": "string"
