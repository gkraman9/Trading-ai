{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "research_version": {
      "const": 1
    },
    "kind": {
      "const": "SR_REJECTION_RESEARCH"
    },
    "strategy_id": {
      "const": "SR_REJECTION_M1_CONFIRMATION"
    },
    "rule_version": {
      "const": "1.0.0"
    },
    "validation_status": {
      "const": "SYNTHETIC_ONLY"
    },
    "status": {
      "enum": [
        "BLOCKED",
        "EVALUATED"
      ]
    },
    "symbol": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "evaluation_at_utc": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "enum": [
        null,
        "SYNTHETIC_RESEARCH",
        "HISTORICAL_RESEARCH"
      ]
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "view": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "context": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "configuration_hashes": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {},
              "required": []
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "context": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "intelligence": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "break_tolerance": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "context",
                "intelligence",
                "break_tolerance"
              ]
            }
          ]
        },
        "policy": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "dataset": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "view",
        "context",
        "configuration_hashes",
        "policy",
        "dataset"
      ]
    },
    "current_bar": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^M[15]:[A-Z_]+:[a-f0-9]{64}$"
            },
            "opened_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|\\+00:00)$"
            },
            "closed_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|\\+00:00)$"
            },
            "close": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "id",
            "opened_at",
            "closed_at",
            "close"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "current_opposition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "BULLISH": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^M[15]:[A-Z_]+:[a-f0-9]{64}$"
          }
        },
        "BEARISH": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^M[15]:[A-Z_]+:[a-f0-9]{64}$"
          }
        }
      },
      "required": [
        "BULLISH",
        "BEARISH"
      ]
    },
    "evidence": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^M[15]:[A-Z_]+:[a-f0-9]{64}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "CANDLE",
              "CONFIRMED_PIVOT",
              "ZONE",
              "LIQUIDITY_POOL",
              "LIQUIDITY_EVENT",
              "CHOCH_EVENT",
              "CONTEXT_CANDLE",
              "CONTEXT_STRUCTURE",
              "CONTEXT_TRANSITION",
              "CONTEXT_MOMENTUM",
              "CONTEXT_VOLATILITY",
              "CONTEXT_SUPPORT_RESISTANCE",
              "CONTEXT_SUPPLY_DEMAND",
              "CONTEXT_LIQUIDITY"
            ]
          },
          "timeframe": {
            "enum": [
              "M1",
              "M5"
            ]
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "(Z|\\+00:00)$"
          },
          "available_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "(Z|\\+00:00)$"
          }
        },
        "required": [
          "kind",
          "timeframe",
          "observed_at",
          "available_at"
        ]
      }
    },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "setup_id": {
            "type": "string",
            "pattern": "^SRSETUP:[a-f0-9]{64}$"
          },
          "direction": {
            "enum": [
              "BULLISH",
              "BEARISH"
            ]
          },
          "state": {
            "enum": [
              "CANDIDATE",
              "QUALIFIED",
              "ABSTAINED",
              "INVALIDATED"
            ]
          },
          "zone": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^M[15]:[A-Z_]+:[a-f0-9]{64}$"
              },
              "kind": {
                "enum": [
                  "SUPPORT",
                  "RESISTANCE"
                ]
              },
              "timeframe": {
                "enum": [
                  "M1",
                  "M5"
                ]
              },
              "lower": {
                "type": "number"
              },
              "upper": {
                "type": "number"
              },
              "confirmed_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "(Z|\\+00:00)$"
              },
              "status": {
                "enum": [
                  "FRESH",
                  "TESTED",
                  "BROKEN",
                  "ROLE_REVERSAL_CANDIDATE",
                  "INVALIDATED"
                ]
              }
            },
            "required": [
              "id",
              "kind",
              "timeframe",
              "lower",
              "upper",
              "confirmed_at",
              "status"
            ]
          },
          "candles": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "P": {
                "type": "string",
                "pattern": "^M[15]:[A-Z_]+:[a-f0-9]{64}$"
              },
              "T": {
                "type": "string",
                "pattern": "^M[15]:[A-Z_]+:[a-f0-9]{64}$"
              },
              "C": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^M[15]:[A-Z_]+:[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "P",
              "T",
              "C"
            ]
          },
          "conditions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "zone_active": {
                "type": "boolean"
              },
              "zone_known": {
                "type": "boolean"
              },
              "m5_compatible": {
                "type": "boolean"
              },
              "previous_not_touching": {
                "type": "boolean"
              },
              "touch_close_inside": {
                "type": "boolean"
              },
              "contiguous": {
                "type": "boolean"
              },
              "confirmation_body": {
                "type": "boolean"
              },
              "confirmation_break": {
                "type": "boolean"
              },
              "no_opposing_choch": {
                "type": "boolean"
              }
            },
            "required": [
              "zone_active",
              "zone_known",
              "m5_compatible",
              "previous_not_touching",
              "touch_close_inside",
              "contiguous",
              "confirmation_body",
              "confirmation_break",
              "no_opposing_choch"
            ]
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "supporting_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^M[15]:[A-Z_]+:[a-f0-9]{64}$"
            }
          },
          "contradictory_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^M[15]:[A-Z_]+:[a-f0-9]{64}$"
            }
          },
          "invalidation_conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exit_hypothesis": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "PAPER_OBSERVATION_ONLY"
              },
              "opposing_zones": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^M[15]:[A-Z_]+:[a-f0-9]{64}$"
                    },
                    "kind": {
                      "enum": [
                        "SUPPORT",
                        "RESISTANCE"
                      ]
                    },
                    "timeframe": {
                      "enum": [
                        "M1",
                        "M5"
                      ]
                    },
                    "lower": {
                      "type": "number"
                    },
                    "upper": {
                      "type": "number"
                    },
                    "confirmed_at": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "(Z|\\+00:00)$"
                    },
                    "status": {
                      "enum": [
                        "FRESH",
                        "TESTED",
                        "BROKEN",
                        "ROLE_REVERSAL_CANDIDATE",
                        "INVALIDATED"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "kind",
                    "timeframe",
                    "lower",
                    "upper",
                    "confirmed_at",
                    "status"
                  ]
                }
              },
              "expiry_eligible_closes": {
                "const": 5
              },
              "unresolved_if": {
                "const": "SIMULTANEOUS_EVENTS_OR_OHLC_ORDER_UNKNOWN"
              }
            },
            "required": [
              "kind",
              "opposing_zones",
              "expiry_eligible_closes",
              "unresolved_if"
            ]
          }
        },
        "required": [
          "setup_id",
          "direction",
          "state",
          "zone",
          "candles",
          "conditions",
          "reason_codes",
          "supporting_evidence",
          "contradictory_evidence",
          "invalidation_conditions",
          "exit_hypothesis"
        ]
      }
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "restrictions": {
      "anyOf": [
        {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "data_quality",
            "session",
            "calendar_qualification",
            "missing_timeframes",
            "warmup",
            "reason_codes",
            "qualification_snapshot"
          ],
          "properties": {
            "data_quality": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Quality"
                },
                {
                  "type": "null"
                }
              ]
            },
            "session": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Session"
                },
                {
                  "type": "null"
                }
              ]
            },
            "calendar_qualification": {
              "enum": [
                "UNKNOWN",
                "BLOCKED",
                "VERIFIED_DECLARATIONS"
              ]
            },
            "missing_timeframes": {
              "type": "array",
              "items": {
                "enum": [
                  "M1",
                  "M5"
                ]
              },
              "uniqueItems": true
            },
            "warmup": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reason_codes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "qualification_snapshot": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Safety"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      ]
    },
    "mode": {
      "const": "READ_ONLY_SHADOW"
    },
    "signal": {
      "const": "WAIT"
    },
    "execution_allowed": {
      "const": false
    },
    "qualification": {
      "const": "DATA_NOT_QUALIFIED"
    },
    "exness": {
      "const": "BLOCKED"
    },
    "historical_validation": {
      "const": "PENDING"
    },
    "historical_comparisons": {
      "const": "NOT_RUN"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "research_version",
    "kind",
    "strategy_id",
    "rule_version",
    "validation_status",
    "status",
    "symbol",
    "evaluation_at_utc",
    "provenance",
    "bindings",
    "current_bar",
    "current_opposition",
    "evidence",
    "evaluations",
    "reason_codes",
    "restrictions",
    "mode",
    "signal",
    "execution_allowed",
    "qualification",
    "exness",
    "historical_validation",
    "historical_comparisons",
    "sha256"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iat.invalid/schemas/sr-rejection-research-v1.schema.json",
  "title": "S/R rejection synthetic-only research snapshot v1",
  "description": "Shape only; validate_sr_result also checks identity, chronology, hashes and optional exact source mapping. No execution or data qualification.",
  "$defs": {
    "Quality": {
      "type": "object",
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "VALID",
            "BLOCKED"
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "severity": {
                "enum": [
                  "INFO",
                  "WARNING",
                  "ERROR"
                ]
              },
              "message": {
                "type": "string"
              },
              "timeframe": {
                "enum": [
                  "M1",
                  "M5"
                ]
              }
            },
            "required": [
              "code",
              "severity",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "valid",
        "status",
        "diagnostics"
      ],
      "additionalProperties": false
    },
    "Session": {
      "type": "object",
      "properties": {
        "version": {
          "const": 2
        },
        "configuration_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "provenance_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "evaluated_at_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "evidence_latest_at_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "coverage_start_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "coverage_end_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "expires_at_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "verification": {
          "enum": [
            "BLOCKED",
            "VERIFIED_DECLARATIONS"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provenance_kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "uniqueItems": true
        },
        "permissions": {
          "type": "object",
          "properties": {
            "phase": {
              "enum": [
                "UNKNOWN",
                "CLOSED",
                "QUOTE_ONLY",
                "CLOSE_ONLY",
                "FULL_TRADING"
              ]
            },
            "market_data_expected": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "broker_open_positions": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "broker_close_positions": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "broker_permissions_verified": {
              "type": "boolean"
            },
            "iat_execution_allowed": {
              "const": false
            }
          },
          "required": [
            "phase",
            "market_data_expected",
            "broker_open_positions",
            "broker_close_positions",
            "broker_permissions_verified",
            "iat_execution_allowed"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "configuration_sha256",
        "provenance_count",
        "evaluated_at_utc",
        "evidence_latest_at_utc",
        "coverage_start_utc",
        "coverage_end_utc",
        "expires_at_utc",
        "verification",
        "reason_codes",
        "provenance_kinds",
        "permissions"
      ],
      "additionalProperties": false
    },
    "Safety": {
      "type": "object",
      "properties": {
        "mode": {
          "const": "READ_ONLY_SHADOW"
        },
        "signal": {
          "const": "WAIT"
        },
        "execution_allowed": {
          "const": false
        },
        "qualification": {
          "const": "DATA_NOT_QUALIFIED"
        },
        "exness": {
          "const": "BLOCKED"
        },
        "historical_validation": {
          "const": "PENDING"
        },
        "historical_comparisons": {
          "const": "NOT_RUN"
        }
      },
      "required": [
        "mode",
        "signal",
        "execution_allowed",
        "qualification",
        "exness",
        "historical_validation",
        "historical_comparisons"
      ],
      "additionalProperties": false
    }
  }
}
